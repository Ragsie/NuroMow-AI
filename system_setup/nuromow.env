# ==============================================================================
#             NUROMOW HARDWARE & CHASSIS CONFIGURATION (Single Source of Truth)
# ==============================================================================

# --- CHASSIS DIMENSIONER & MOTORSTYRING ---
# Worx Landroid M600 Plus standard = 0.40 (40 cm sporvidde)
NUROMOW_TRACK_WIDTH=0.40
# Robot-radius brugt til kollisionszone (meter)
NUROMOW_ROBOT_RADIUS=0.28
# Sikkerhedsmargen i Nav2 costmap inflation (meter)
NUROMOW_NAV2_INFLATION_RADIUS=0.35

# Autoro VESC CAN-ID'er
NUROMOW_VESC_LEFT_ID=1
NUROMOW_VESC_RIGHT_ID=2

# --- 3D STEREO VISION SPECIFIKATIONER ---
# GXIVISION standard baseline = 0.06 (60 mm afstand mellem linser)
NUROMOW_CAMERA_BASELINE=0.06
# Brændvidde i pixels (focal length) for dybdeberegning Z = (B * F) / D
NUROMOW_CAMERA_FOCAL_LENGTH=350.0

# --- SENSOR PLACERINGER (URDF OFFSETS I METER) ---
# Kameraets monteringshøjde (Z) over jorden på klipperen
NUROMOW_CAMERA_HEIGHT_Z=0.10
# Kameraets afstand (X) fremad i forhold til robottens rotationscentrum (base_link)
NUROMOW_CAMERA_OFFSET_X=0.25
# Kameraets hældningsvinkel (Pitch) i radianer (0.0 = vandret, positive værdier peger nedad)
NUROMOW_CAMERA_PITCH_Y=0.0

# GPS-antennens placering i forhold til rotationscentrum
NUROMOW_GPS_OFFSET_X=-0.15
NUROMOW_GPS_HEIGHT_Z=0.25

# --- MLOPS / LOKAL NFS AI TRÆNINGSSERVER ---
# Angiv IP-adresse på din lokale GPU-træningsserver (f.eks. 192.168.1.100)
# Efterlad tom (""), hvis du ikke bruger en lokal server og gemmer billeder lokalt på klipperens NVMe SSD.
NUROMOW_NFS_SERVER_IP=""

# Stien til NFS-delingen på din GPU-server, hvor billeder skal uploades (f.eks. /mnt/nfs/nuromow_raw)
NUROMOW_NFS_SHARE="/mnt/nfs/nuromow_raw"