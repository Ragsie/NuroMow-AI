# ==============================================================================
#             NUROMOW HARDWARE & CHASSIS CONFIGURATION (Single Source of Truth)
# ==============================================================================

# --- CHASSIS DIMENSIONS & MOTOR CONTROL ---
# Worx Landroid M600 Plus standard = 0.40 (40 cm track width)
NUROMOW_TRACK_WIDTH=0.40
# Robot-radius used for collision zone (meters)
NUROMOW_ROBOT_RADIUS=0.28
# Safety margin in Nav2 costmap inflation (meters)
# SAFETY DISTANCE FOR ASYMMETRIC CUTTER HEAD (WORX CUT-TO-EDGE):
# Since the cutter head is positioned completely on the right side of the Worx chassis, we increase the standard inflation-radius
# from 0.35m to 0.48m (provides a solid 20 cm safety margin beyond the robot's physical body of 28 cm).
# This ensures that the rotating cutter disc never swings into walls, beds or pots during turns!
NUROMOW_NAV2_INFLATION_RADIUS=0.48

# Autoro VESC CAN-ID'er
NUROMOW_VESC_LEFT_ID=1
NUROMOW_VESC_RIGHT_ID=2

# --- 3D STEREO MIPI CSI CAMERA SPECIFICATIONS ---
# Standard baseline for IMX219 Binocular is 60mm (0.06m)
NUROMOW_CAMERA_BASELINE=0.06
# Focal length in pixels (focal length) for depth calculation Z = (B * F) / D
NUROMOW_CAMERA_FOCAL_LENGTH=350.0

# --- SENSOR LOCATIONS (URDF OFFSETS IN METERS) ---
# Camera mounting height (Z) above ground on the mower
NUROMOW_CAMERA_HEIGHT_Z=0.10
# Camera distance (X) forward relative to the robot's center of rotation (base_link)
NUROMOW_CAMERA_OFFSET_X=0.25
# Camera pitch angle (Pitch) in radians (0.0 = horizontal, positive values point downward)
NUROMOW_CAMERA_PITCH_Y=0.0

# GPS antenna location relative to center of rotation
NUROMOW_GPS_OFFSET_X=-0.15
NUROMOW_GPS_HEIGHT_Z=0.25

# MIPI CSI devices for the two lenses (v4l2 nodes)
NUROMOW_CAMERA_DEVICE_LEFT="/dev/video0"
NUROMOW_CAMERA_DEVICE_RIGHT="/dev/video1"

# --- MLOPS / LOCAL NFS AI TRAINING SERVER ---
# Specify the IP address of your local GPU training server (e.g., 192.168.1.100)
# Leave empty (""), if you don't use a local server and save images locally on the mower's NVMe SSD.
NUROMOW_NFS_SERVER_IP=""

# Path to NFS share on your GPU server where images should be uploaded (e.g., /mnt/nfs/nuromow_raw)
NUROMOW_NFS_SHARE="/mnt/nfs/nuromow_raw"