<?xml version="1.0"?>
<robot name="nuromower">
  <!-- Hovedchassis (base_link) -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.6 0.4 0.3"/>
      </geometry>
      <material name="orange">
        <color rgba="1.0 0.5 0.0 1.0"/>
      </material>
    </visual>
  </link>

  <!-- 3D Stereo Vision Kamera Joint -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- Dynamiske parametre udlæses af launch-filen og indsprøjtes her --> 🆕 [DYNAMISKE PARAMS]
    <origin xyz="{CAMERA_OFFSET_X} 0.0 {CAMERA_HEIGHT_Z}" rpy="0.0 {CAMERA_PITCH_Y} 0.0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.03 0.12 0.03"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <!-- GNSS / RTK-GPS Modtager Joint (Rover) -->
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <!-- Dynamiske parametre udlæses af launch-filen og indsprøjtes her --> 🆕 [DYNAMISKE PARAMS]
    <origin xyz="{GPS_OFFSET_X} 0.0 {GPS_HEIGHT_Z}" rpy="0.0 0.0 0.0"/>
  </joint>

  <link name="gps_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
      <material name="white">
        <color rgba="1.0 1.0 1.0 1.0"/>
      </material>
    </visual>
  </link>
</robot>