<?xml version="1.0"?>
<robot name="worx_mower">

  <!-- ========================================== -->
  <!-- BASE OF THE ROBOT                          -->
  <!-- ========================================== -->
  
  <!-- Base Link: The mathematical center of the robot (usually center of the drive wheels) -->
  <link name="base_link">
  </link>

  <!-- Footprint: The actual ground directly below base_link -->
  <link name="base_footprint">
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- Set Z to the distance from the ground to the center of your wheels (e.g., 5cm) -->
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- ========================================== -->
  <!-- STEREO CAMERA MOUNT                        -->
  <!-- ========================================== -->
  
  <!-- Camera Link: Where the stereo camera is mounted -->
  <link name="camera_link">
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- GRAB A TAPE MEASURE:
         xyz="X Y Z" (in meters)
         X = Distance forward from wheel center
         Y = Distance left/right from center (0 if perfectly centered)
         Z = Height above wheel center
         Example below: Mounted 20cm forward, perfectly centered, 15cm high. -->
    <origin xyz="0.20 0.0 0.15" rpy="0 0 0"/>
  </joint>

</robot>
