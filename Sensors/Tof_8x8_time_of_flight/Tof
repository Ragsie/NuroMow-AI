import rclpy
from rclpy.node import Node
from sensor_msgs.msg import Range  # Bruger en standard ROS-besked til afstand
import board
import busio
import adafruit_tca9548a
from adafruit_vl53l5cx import VL53L5CX

class ToFSensorNode(Node):
    def __init__(self):
        super().__init__('tof_sensor_node')
        
        # 1. Start I2C bussen på Raspberry Pi
        i2c = board.I2C()
        
        # 2. Forbind til Multiplexeren (TCA9548A)
        self.tca = adafruit_tca9548a.TCA9548A(i2c)
        
        self.get_logger().info("Multiplexer fundet! Initialiserer sensorer...")
        
        # 3. Fortæl Pi'en, hvilken kanal sensorerne sidder på
        # self.tca[0] betyder "Kanal 0 på multiplexeren"
        self.sensor_front_left = VL53L5CX(self.tca[0])
        self.sensor_front_right = VL53L5CX(self.tca[1])
        
        # 4. Sæt sensorerne til at læse lynhurtigt (f.eks. 15 Hz)
        self.sensor_front_left.start_ranging()
        self.sensor_front_right.start_ranging()
        
        # 5. Opret ROS 2 Publishers (Kanalerne hvor Nav2 lytter)
        self.pub_left = self.create_publisher(Range, 'sensors/tof_left', 10)
        self.pub_right = self.create_publisher(Range, 'sensors/tof_right', 10)
        
        # 6. Kør aflæsnings-funktionen 10 gange i sekundet (0.1 sek)
        self.timer = self.create_timer(0.1, self.read_sensors_callback)

    def read_sensors_callback(self):
        # --- Læs og send data for VENSTRE sensor ---
        if self.sensor_front_left.data_ready:
            # Hent 8x8 grid data (64 afstande). 
            # (I praksis vil man ofte bare bruge gennemsnittet af midten, eller sende det hele som et PointCloud)
            distance_data = self.sensor_front_left.distance
            
            msg = Range()
            msg.header.stamp = self.get_clock().now().to_msg()
            msg.header.frame_id = "tof_left_link"
            msg.range = distance_data[36] # Eksempel: Læs zonen i midten
            
            self.pub_left.publish(msg)

        # --- Læs og send data for HØJRE sensor ---
        if self.sensor_front_right.data_ready:
            distance_data = self.sensor_front_right.distance
            # ... pak og send ligesom venstre ...

def main(args=None):
    rclpy.init(args=args)
    node = ToFSensorNode()
    rclpy.spin(node)
    node.destroy_node()
    rclpy.shutdown()

if __name__ == '__main__':
    main()